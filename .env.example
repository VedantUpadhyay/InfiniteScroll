# MindChat sponsor integrations
OPENAI_API_KEY=
TAVILY_API_KEY=
TAVILY_PROVIDER=mcp
# Optional: leave blank to auto-build Tavily MCP URL from TAVILY_API_KEY
TAVILY_MCP_SERVER_URL=

# Neo4j AuraDB (long-term memory)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional model overrides
OPENAI_CHAT_MODEL=gpt-3.5-turbo
OPENAI_ANALYSIS_MODEL=gpt-4o
OPENAI_RATE_LIMIT_RETRIES=3
OPENAI_RETRY_BASE_DELAY_SECONDS=1.0
